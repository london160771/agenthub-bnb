# ---- Server ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for CORS
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Required in production. Development may omit it to use the ephemeral in-memory database.
# Example (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/agenthub
MONGODB_URI=

# ---- AI (optional) ----
# Used by the Agent Finder for natural-language task classification.
# If absent, the backend falls back to deterministic keyword matching.
AI_API_KEY=
AI_MODEL=
# Optional endpoint for AI chat completions (OpenAI-compatible). If unset, AI
# classification is skipped and the deterministic fallback is used.
AI_API_BASE=

# ---- Discovery / 8004scan (optional) ----
# BSC agent registry. 8004scan works WITHOUT a key (anonymous: 30 req/min,
# 1,000/day). Set a key for bulk ingestion (600/min, 100k/day). NEVER expose
# this key to the frontend — it lives in trusted backend only.
# Get a key at https://8004scan.io/developers
SCAN8004_API_KEY=
# SCAN8004_BASE_URL=https://api.8004scan.io/api/v1

# ---- BNB Smart Chain ----
# Current official public endpoints (docs.bnbchain.org JSON-RPC endpoints).
# Mainnet chainId 56, Testnet chainId 97.
#
# BNB_TESTNET_RPC_URL is READ AT RUN TIME by every agent execution: balances,
# blocks, gas price and Venus contract reads all go through it. It is NOT
# required — the value below is the default the code falls back to when it is
# unset. Set it only to point at a different testnet endpoint (a private node,
# or a proxy for testing).
#
# BNB_RPC_URL (mainnet) is used for public receipt verification if a previously
# verified paid-executable agent is enabled. Paid-ready listings are preflight
# only. AgentHub never stores a key or broadcasts from the backend.
BNB_RPC_URL=https://bsc-dataseed.bnbchain.org
BNB_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
