# ---- Server ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for CORS
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Optional until Phase 2 (marketplace uses seeded MongoDB data).
# Example (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/agenthub
MONGODB_URI=

# ---- AI (optional) ----
# Used by the Agent Finder for natural-language task classification.
# If absent, the backend falls back to deterministic keyword matching.
AI_API_KEY=
AI_MODEL=

# ---- BNB Smart Chain ----
# Current official public endpoints (docs.bnbchain.org JSON-RPC endpoints).
# Mainnet chainId 56, Testnet chainId 97.
#
# BNB_TESTNET_RPC_URL is READ AT RUN TIME by every agent execution: balances,
# blocks, gas price and Venus contract reads all go through it. It is NOT
# required — the value below is the default the code falls back to when it is
# unset. Set it only to point at a different testnet endpoint (a private node,
# or a proxy for testing).
#
# BNB_RPC_URL (mainnet) is present for completeness and is NOT used: executions
# are testnet-only and no code path selects the mainnet endpoint. All reads are
# read-only eth_call/eth_get* — nothing is ever signed or broadcast.
BNB_RPC_URL=https://bsc-dataseed.bnbchain.org
BNB_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
