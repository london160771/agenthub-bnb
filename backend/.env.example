# ---- Server ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for CORS
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Optional until Phase 2 (marketplace uses seeded MongoDB data).
# Example (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/agenthub
MONGODB_URI=

# ---- AI (optional) ----
# Used by the Agent Finder for natural-language task classification.
# If absent, the backend falls back to deterministic keyword matching.
AI_API_KEY=
AI_MODEL=

# ---- BNB Smart Chain ----
# Public endpoints — verify against current official BNB Chain docs before production use.
# Mainnet chainId 56, Testnet chainId 97.
BNB_RPC_URL=https://bsc-dataseed.binance.org
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
