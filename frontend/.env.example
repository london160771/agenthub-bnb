# API base URL. Leave empty in development to use the Vite proxy ("/api").
# In production set this to your deployed backend, e.g. https://api.agenthub.app/api
VITE_API_URL=

# Default chain for the UI: "testnet" (BNB Chapel, id 97) or "mainnet" (id 56).
VITE_DEFAULT_CHAIN=testnet

# WalletConnect project id (used later by the wallet phase). Optional.
VITE_WALLETCONNECT_PROJECT_ID=
