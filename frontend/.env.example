# API base URL. Leave empty in development to use the Vite proxy ("/api").
# In production set this to your deployed backend, e.g. https://api.agenthub.app/api
VITE_API_URL=

# Default chain for the UI: "testnet" (BNB Smart Chain Testnet, id 97) or
# "mainnet" (id 56). Hiring is testnet-only; the backend rejects chain 56.
VITE_DEFAULT_CHAIN=testnet

# WalletConnect project id. NOT required: the wallet integration reads the
# browser's injected EIP-1193 provider (window.ethereum) directly, which needs
# no project id, no API key and no secret. Only fill this in if WalletConnect
# (for mobile wallets) is added later.
VITE_WALLETCONNECT_PROJECT_ID=
